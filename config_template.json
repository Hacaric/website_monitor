{
    "check_delay_seconds":7200,
    "online_check_reference":"google.com",
    "online_check_delay_seconds":30,
    "default_url_prefix":"https://",
    "ignore_inital_status_check":true,
    "targets":[{
        "url":WEBSITE_URL,
        "require_ssl_certificate":false,
        "webhook_username":"Website monitor", 
        "save_diffs":true,
        
        "loggers":[
            {
                "type":"BOT",
                "token":TOKEN,
                "target_type":"CHANNEL",
                "target_id":channel_id,
                "message_format":{
                    "on_start": "Website monitor for url {url} has started!",
                    "status_change": "`{url}` changed status code to {status_code}!",
                    "content_change": "Content of {url} has changed."
                }
            },
            {
                "type":"WEBHOOK",           
                "webhook_url":WEBHOOK_URL,
                "message_format":{
                    "on_start": "Website monitor for url {url} has started!",
                    "status_change": "`{url}` changed status code to {status_code}!",
                    "content_change": "Content of {url} has changed."
                },
                "webhook_username":"Website monitor of {url}" 
            }
        ],
        "use_discord_on_status_change":false,
        "check_content_changes":true,
        "use_discord_on_content_change":false
    }]
}